# ── Zugriffsschutz ────────────────────────────────────────────────────────────
# Beliebiges langes Zufalls-Token. Kurzbefehl und Web-App schicken es als
# "Authorization: Bearer <TOKEN>" mit. Erzeugen z.B. mit:
#   openssl rand -hex 32
APP_TOKEN=bitte-aendern

PORT=3000
HOST=0.0.0.0

# ── Notion ────────────────────────────────────────────────────────────────────
# notion.so/profile/integrations -> neue Integration -> Internal Integration Secret
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Aus der URL deiner Rezept-Datenbank (die 32 Zeichen vor dem "?v=")
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── KI ────────────────────────────────────────────────────────────────────────
# aistudio.google.com -> "Get API key" (kostenlos, ohne Kreditkarte)
GEMINI_API_KEY=

# Feste Version statt eines "-latest"-Namens: Letztere zeigen laut Google auf
# experimentelle Modelle mit engeren Limits - die Ursache sporadischer 503er.
# Welche Namen dein Key kennt, zeigt:  npm run models
GEMINI_MODEL=gemini-3.5-flash

# Wird angelaufen, wenn das Hauptmodell auch nach mehreren Versuchen ueberlastet
# bleibt (HTTP 503). Bewusst eine andere Generation - ist eine belegt, ist die
# andere es meist nicht. Leer lassen = kein Ausweichmodell.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Nur relevant bei TRANSCRIBE_PROVIDER=gemini: eigenes Modell fuer Audio.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Woher kommt das Transkript, wenn kein Gratis-Text (Untertitel/Caption) reicht?
#   local  = faster-whisper auf diesem Server (kostenlos, keine Limits)
#   gemini = Audio direkt an Gemini (spart CPU, zaehlt aufs Free-Tier-Limit)
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ── Verhalten ─────────────────────────────────────────────────────────────────
# Ab wie vielen Zeichen gilt vorhandener Text (Untertitel/Beschreibung) als
# ausreichend, sodass die Transkription uebersprungen wird?
FREE_TEXT_MIN_CHARS=400

# Tags in Notion mit fuehrendem "#" speichern? (false = empfohlen)
TAGS_WITH_HASH=false

# Wert fuer die Status-Spalte bei NEU erfassten Rezepten. Muss exakt einer der
# Optionen deiner Notion-Spalte entsprechen. Leer lassen = Status nicht setzen.
# Wird nur beim Anlegen gesetzt, nie beim Aktualisieren - ein erneuter Import
# soll deinen Arbeitsstand nicht zurueckwerfen.
NEW_RECIPE_STATUS=Ausprobieren

# yt-dlp beim Start automatisch aktualisieren. Die Plattformen aendern staendig
# etwas - das hier ist die haeufigste Ursache fuer "ging gestern noch".
YTDLP_AUTO_UPDATE=true

# Optional: Cookies fuer Instagram (Pflicht) und YouTube (zunehmend noetig).
# Siehe docs/cookies.md
COOKIES_FILE=config/cookies.txt

# ── Nur fuer den optionalen Tailscale-Container (docs/tailscale.md) ───────────
TS_AUTHKEY=
